function startAd() {
  adDiv = document.getElementById("ad");

  const selectElement = document.getElementById("country-code-select");
  COUNTRY_PHONE_FORMATS.forEach((country) => {
    const option = document.createElement("option");
    option.value = country.id;
    option.setAttribute("data-country-id", country.id);
    option.text = `${country.emoji} ${country.code}`;
    selectElement.appendChild(option);
  });
}

function clickPropogationFn(e) {
  const input = e.currentTarget;
  // input.style.border = "#80bdff 2px solid";
  // input.style.boxShadow = "none";
  if (!selected) {
    setTimeout(() => {
      selected = true;
    }, 0);
  }
  e = e || window.event;
  e.stopPropagation();
}

document.getElementById("phone-number").addEventListener("click", clickPropogationFn);
document.getElementById("phone-number").addEventListener("focus", function (e) {
  if (!selected) {
    setTimeout(() => {
      selected = true;
    }, 0);
  }
  e = e || window.event;
  e.stopPropagation();
});

document.getElementById("clickthrough-button").addEventListener("click", function (e) {
  e = e || window.event;
  e.stopPropagation();
});

function removeNonLatinChars(str) {
  const text = `${str || ""}`.trim();
  return text.replace(/[^\u0020-\u007e\u00a0-\u00ff]/g, "");
}

function validate_form(form) {
  const phone = removeNonLatinChars(form.phone.value)?.replaceAll(" ", "");

  const countryId = form.phone_code.value;
  const country = COUNTRY_PHONE_FORMATS.find((c) => c.id === countryId)?.code || "";

  // if (phone.replace(/\D/g, "").length === 0) {
  //   form.phone.setCustomValidity("Enter Valid Phone Number");
  //   form.phone.reportValidity(); // This will trigger the error message
  //   return false;
  // }

  const encodedPhone = encodeURIComponent(window.btoa(phone.length > 0 ? country + phone : ""));
  var qpSep = window.clickTag.indexOf("?") !== -1 ? "&" : "?";
  var newUrl = qpSep + "phone=" + encodedPhone + "&countryName=" + encodeURIComponent(countryId);
  window.clickTag += newUrl;
}

startAd();
